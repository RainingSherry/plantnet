# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Symbolic link to external data directory
data/

# Processed / converted datasets (generated from raw .h5 inputs)
data/processed/

# Results / outputs (generated, not needed in repo)
# Raw results are excluded:
results/
# But formal benchmark summary tables are committed:
!results/formal/*/benchmark_summary*.csv
!results/formal/*/*/benchmark_summary*.csv
# Also commit analysis summaries:
!results/analysis/dataset_property_summary.csv
!results/analysis/neighbormix_gain_summary.csv
!results/analysis/neighbormix_property_correlation.csv
!results/analysis/neighbormix_effect_interpretation.csv

# Large data/model files (track these with Git LFS instead)
# These patterns are here as a fallback for files not tracked by LFS:
*.h5
*.h5ad
*.pth
*.pt
*.npy
*.npz
*.parquet
*.loom

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Virtual environments
venv/
env/
.venv/
.env/
.codex_tex/
.mamba-root/

# Runtime registry with local absolute paths (commit only the example)
envs/runtime_registry.yaml

# Python build artifacts
*.egg-info/
dist/
build/
*.egg

# Temporary / scratch files
*.tmp
*.temp
.cache/
.codegraph/
cache/

# LaTeX build intermediates
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc

# Large PDFs
0/普林斯顿数学指南.pdf
paper/protocol_analysis_manuscript/main.pdf
